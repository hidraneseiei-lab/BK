# ELF header (64 byte)
7F 45 4C 46 02 01 01 00 00 00 00 00 00 00 00 00
02 00 B7 00 01 00 00 00 78 00 40 00 00 00 00 00
40 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 40 00 38 00 01 00 00 00 00 00 00 00
# Program header (56 byte)
01 00 00 00 05 00 00 00 00 00 00 00 00 00 00 00
00 00 40 00 00 00 00 00 00 00 40 00 00 00 00 00
9D 00 00 00 00 00 00 00 9D 00 00 00 00 00 00 00
00 00 20 00 00 00 00 00
# Kode
08 08 80 D2   # mov x8, 64 (write)
20 00 80 D2   # mov x0, 1 (stdout)
C1 00 00 10   # adr x1, teks
A2 00 80 D2   # mov x2, 5 (panjang)
01 00 00 D4   # svc 0
A8 0B 80 D2   # mov x8, 93 (exit)
00 00 80 D2   # mov x0, 0
01 00 00 D4   # svc 0
# Data
48 61 6C 6F 0A   # Halo
